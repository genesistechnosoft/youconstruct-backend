// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum PlatformRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  CUSTOMER
  VENDOR
  PROFESSIONAL
}

enum PermissionScope {
  ADMIN
  VENDOR
  PROFESSIONAL
}

enum TeamMemberStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  PHONE
}

enum KycDocumentType {
  AADHAAR
  PAN
  GST
}

enum KycStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
}

enum SuggestionSourceType {
  PRODUCT
  CATEGORY
}

enum VendorOnboardingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum VendorPlan {
  FREE
  PRO
  ENTERPRISE
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PayoutTriggerType {
  MANUAL
  SCHEDULED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionReason {
  ORDER_EARNING
  PAYOUT
  REFUND_DEDUCTION
  ADJUSTMENT
}

enum PreferredPaymentMethod {
  CASH
  ONLINE
  BOTH
}

enum ShippingMethodType {
  FLAT
  FREE
  DISTANCE_BASED
  UNIT_BASED
  ORDER_VALUE_BASED
}

enum ShippingUnitType {
  UNIT
  KG
  CBM
}

enum MediaOwnerType {
  VENDOR
  PROFESSIONAL
  ADMIN
  /// Compliance / KYC docs owned by the user, never listed in store media libraries
  USER
}

enum MediaAccessLevel {
  PUBLIC
  PRIVATE
  SIGNED
}

enum MediaFileType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum StorageDriver {
  LOCAL
  R2
}

enum MediaProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum MediaEntityType {
  PRODUCT
  PRODUCT_VARIANT
  VENDOR_PROFILE
  PROFESSIONAL_PROFILE
  CATEGORY
  BRAND
  HOMEPAGE_BANNER
}

enum MediaContext {
  GALLERY
  PRIMARY
  LOGO
  BANNER
  THUMBNAIL
  CATEGORY_IMAGE
  BRAND_LOGO
  PROFILE_PHOTO
  PROJECT_PHOTO
  REEL
  OG_IMAGE
}

enum MediaProcessingJobType {
  IMAGE_COMPRESS
  THUMBNAIL_GENERATE
  VIDEO_TRANSCODE
}

enum MediaProcessingJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id              String       @id @default(uuid())
  name            String
  email           String?      @unique
  phone           String?      @unique
  passwordHash    String?
  platformRole    PlatformRole @default(CUSTOMER)
  provider        AuthProvider @default(EMAIL)
  googleId        String?      @unique
  avatarUrl       String?
  isEmailVerified Boolean      @default(false)
  isPhoneVerified Boolean      @default(false)
  isActive        Boolean      @default(true)
  fcmToken        String?
  /// MFA-ready fields (MFA not required yet; reserved for future platform staff hardening)
  mfaEnabled      Boolean      @default(false)
  mfaSecret       String?
  mfaBackupCodes  String[]     @default([])
  mfaVerifiedAt   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  addresses              Address[]
  refreshTokens          RefreshToken[]
  otpVerifications       OtpVerification[]
  kycDocuments           KycDocument[]
  uploadedMedia          Media[]
  vendorProfile          VendorProfile?
  professionalProfile    ProfessionalProfile?
  customRolesCreated     CustomRole[]         @relation("CustomRolesCreated")
  teamMemberships        TeamMember[]
  invitationsSent        Invitation[]         @relation("InvitationsSent")
  impersonationsAsAdmin  ImpersonationLog[]   @relation("ImpersonationAdmin")
  impersonationsAsTarget ImpersonationLog[]   @relation("ImpersonationTarget")
  auditLogsAsActor       SecurityAuditLog[]   @relation("SecurityAuditActor")

  @@map("users")
}

model Permission {
  id          String          @id @default(uuid())
  key         String
  name        String
  group       String
  scope       PermissionScope
  description String?
  isElevated  Boolean         @default(false)
  createdAt   DateTime        @default(now())

  rolePermissions RolePermission[]

  @@unique([scope, key])
  @@index([scope])
  @@index([scope, group])
  @@map("permissions")
}

model CustomRole {
  id            String          @id @default(uuid())
  name          String
  scope         PermissionScope
  scopeEntityId String?
  isSystem      Boolean         @default(false)
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  createdBy       User?            @relation("CustomRolesCreated", fields: [createdById], references: [id])
  rolePermissions RolePermission[]
  teamMembers     TeamMember[]
  invitations     Invitation[]

  @@index([scope, scopeEntityId])
  @@map("custom_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  customRoleId String
  permissionId String
  createdAt    DateTime @default(now())

  customRole CustomRole @relation(fields: [customRoleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([customRoleId, permissionId])
  @@map("role_permissions")
}

model TeamMember {
  id            String           @id @default(uuid())
  userId        String
  customRoleId  String
  scope         PermissionScope
  scopeEntityId String?
  status        TeamMemberStatus @default(ACTIVE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  user       User       @relation(fields: [userId], references: [id])
  customRole CustomRole @relation(fields: [customRoleId], references: [id])

  @@index([userId])
  @@index([scope, scopeEntityId])
  @@map("team_members")
}

model Invitation {
  id            String           @id @default(uuid())
  email         String
  tokenHash     String           @unique
  customRoleId  String
  scope         PermissionScope
  scopeEntityId String?
  invitedById   String
  acceptedById  String?
  platformRole  PlatformRole?
  status        InvitationStatus @default(PENDING)
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  customRole CustomRole @relation(fields: [customRoleId], references: [id])
  invitedBy  User       @relation("InvitationsSent", fields: [invitedById], references: [id])

  @@index([email, status])
  @@index([acceptedById])
  @@index([scope, scopeEntityId])
  @@map("invitations")
}

model ImpersonationLog {
  id           String   @id @default(uuid())
  adminId      String
  targetUserId String
  action       String
  method       String?
  path         String?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  admin  User @relation("ImpersonationAdmin", fields: [adminId], references: [id])
  target User @relation("ImpersonationTarget", fields: [targetUserId], references: [id])

  @@index([adminId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("impersonation_logs")
}

model SecurityAuditLog {
  id             String        @id @default(uuid())
  actorUserId    String?
  actorRole      PlatformRole?
  targetUserId   String?
  targetType     String?
  targetId       String?
  action         String
  result         String
  method         String?
  path           String?
  ip             String?
  userAgent      String?
  metadata       Json?
  impersonatedBy String?
  createdAt      DateTime      @default(now())

  actor User? @relation("SecurityAuditActor", fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@map("security_audit_logs")
}

model Address {
  id        String    @id @default(uuid())
  userId    String
  label     String?
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  latitude  Float?
  longitude Float?
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@map("addresses")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model OtpVerification {
  id         String    @id @default(uuid())
  userId     String?
  target     String
  otp        String
  purpose    String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("otp_verifications")
}

model KycDocument {
  id            String          @id @default(uuid())
  userId        String
  mediaId       String?
  documentType  KycDocumentType
  documentNo    String?
  fileUrl       String?
  status        KycStatus       @default(PENDING)
  rejectionNote String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  media Media? @relation(fields: [mediaId], references: [id])

  @@unique([userId, documentType])
  @@index([mediaId])
  @@map("kyc_documents")
}

model VendorProfile {
  id               String                 @id @default(uuid())
  userId           String                 @unique
  businessName     String
  businessAddress  String?
  city             String?
  state            String?
  pincode          String?
  latitude         Float?
  longitude        Float?
  gstNumber        String?
  isApproved       Boolean                @default(false)
  approvedAt       DateTime?
  bio              String?
  onboardingStatus VendorOnboardingStatus @default(DRAFT)
  submittedAt      DateTime?
  reviewedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?

  user           User                  @relation(fields: [userId], references: [id])
  products       Product[]
  storeSettings  VendorStoreSettings?
  membership     VendorMembership?
  wallet         VendorWallet?
  transactions   VendorTransaction[]
  bankAccount    VendorBankAccount?
  payouts        VendorPayout[]
  shippingMethod VendorShippingMethod?

  @@map("vendor_profiles")
}

model VendorStoreSettings {
  id                     String                  @id @default(uuid())
  vendorId               String                  @unique
  shippingPolicy         String?
  refundPolicy           String?
  cancellationPolicy     String?
  preferredPaymentMethod PreferredPaymentMethod?
  supportPhone           String?
  supportEmail           String?
  supportAddressLine1    String?
  supportAddressLine2    String?
  supportCity            String?
  supportState           String?
  supportPincode         String?
  seoTitle               String?
  seoDescription         String?
  seoKeywords            String?
  ogTitle                String?
  ogDescription          String?
  twitterTitle           String?
  twitterDescription     String?
  socialInstagram        String?
  socialFacebook         String?
  socialTwitter          String?
  socialYoutube          String?
  socialLinkedin         String?
  socialPinterest        String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  vendor VendorProfile @relation(fields: [vendorId], references: [id])

  @@map("vendor_store_settings")
}

model VendorMembership {
  id             String     @id @default(uuid())
  vendorId       String     @unique
  plan           VendorPlan @default(FREE)
  startedAt      DateTime   @default(now())
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  storageLimitMb Int        @default(0)
  storageUsedMb  Float      @default(0)
  productLimit   Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  vendor VendorProfile @relation(fields: [vendorId], references: [id])

  @@map("vendor_memberships")
}

model VendorWallet {
  id             String   @id @default(uuid())
  vendorId       String   @unique
  balance        Decimal  @default(0) @db.Decimal(12, 2)
  lockedBalance  Decimal  @default(0) @db.Decimal(12, 2)
  totalEarned    Decimal  @default(0) @db.Decimal(12, 2)
  totalWithdrawn Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vendor       VendorProfile       @relation(fields: [vendorId], references: [id])
  transactions VendorTransaction[]
  payouts      VendorPayout[]

  @@map("vendor_wallets")
}

model VendorTransaction {
  id            String            @id @default(uuid())
  vendorId      String
  walletId      String
  type          TransactionType
  reason        TransactionReason
  amount        Decimal           @db.Decimal(12, 2)
  balanceBefore Decimal           @db.Decimal(12, 2)
  balanceAfter  Decimal           @db.Decimal(12, 2)
  referenceId   String?
  referenceType String?
  note          String?
  createdAt     DateTime          @default(now())

  vendor VendorProfile @relation(fields: [vendorId], references: [id])
  wallet VendorWallet  @relation(fields: [walletId], references: [id])

  @@map("vendor_transactions")
}

model VendorBankAccount {
  id                String    @id @default(uuid())
  vendorId          String    @unique
  accountHolderName String
  accountNumber     String
  ifscCode          String
  bankName          String
  branchName        String?
  isVerified        Boolean   @default(false)
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  vendor  VendorProfile  @relation(fields: [vendorId], references: [id])
  payouts VendorPayout[]

  @@map("vendor_bank_accounts")
}

model VendorPayout {
  id               String            @id @default(uuid())
  vendorId         String
  walletId         String
  bankAccountId    String
  amount           Decimal           @db.Decimal(12, 2)
  status           PayoutStatus      @default(PENDING)
  triggerType      PayoutTriggerType
  scheduledFor     DateTime?
  processedAt      DateTime?
  failureReason    String?
  razorpayPayoutId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  vendor      VendorProfile     @relation(fields: [vendorId], references: [id])
  wallet      VendorWallet      @relation(fields: [walletId], references: [id])
  bankAccount VendorBankAccount @relation(fields: [bankAccountId], references: [id])

  @@map("vendor_payouts")
}

model VendorShippingMethod {
  id                  String              @id @default(uuid())
  vendorId            String              @unique
  methodType          ShippingMethodType
  flatCharge          Decimal?            @db.Decimal(10, 2)
  isFree              Boolean             @default(false)
  freeAboveOrderValue Decimal?            @db.Decimal(10, 2)
  freeWithinKm        Float?
  chargeBeyondKm      Decimal?            @db.Decimal(10, 2)
  unitCharge          Decimal?            @db.Decimal(10, 2)
  unitType            ShippingUnitType?
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  vendor          VendorProfile                   @relation(fields: [vendorId], references: [id])
  orderValueTiers VendorShippingOrderValueTier[]

  @@map("vendor_shipping_methods")
}

model VendorShippingOrderValueTier {
  id               String   @id @default(uuid())
  shippingMethodId String
  minOrderValue    Decimal  @db.Decimal(10, 2)
  maxOrderValue    Decimal? @db.Decimal(10, 2)
  shippingCharge   Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())

  shippingMethod VendorShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)

  @@index([shippingMethodId])
  @@map("vendor_shipping_order_value_tiers")
}

model ProductShippingOverride {
  id                  String             @id @default(uuid())
  productId           String             @unique
  methodType          ShippingMethodType
  flatCharge          Decimal?           @db.Decimal(10, 2)
  isFree              Boolean            @default(false)
  freeAboveOrderValue Decimal?           @db.Decimal(10, 2)
  freeWithinKm        Float?
  chargeBeyondKm      Decimal?           @db.Decimal(10, 2)
  unitCharge          Decimal?           @db.Decimal(10, 2)
  unitType            ShippingUnitType?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@map("product_shipping_overrides")
}

model ProfessionalProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  displayName     String
  slug            String    @unique
  tagline         String?
  bio             String?
  city            String?
  state           String?
  pincode         String?
  latitude        Float?
  longitude       Float?
  experienceYears Int?
  websiteUrl      String?
  instagramUrl    String?
  isApproved      Boolean   @default(false)
  approvedAt      DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user User @relation(fields: [userId], references: [id])

  @@map("professional_profiles")
}

// ─────────────────────────────────────────────
// MODULE 6 — MEDIA
// ─────────────────────────────────────────────

model Media {
  id               String                @id @default(uuid())
  uploadedBy       String
  ownerType        MediaOwnerType
  ownerId          String
  folderId         String?
  fileName         String
  originalName     String
  fileType         MediaFileType
  mimeType         String
  sizeBytes        Int
  width            Int?
  height           Int?
  durationSeconds  Float?
  storageDriver    StorageDriver
  originalKey      String
  optimizedKey     String?
  thumbnailKey     String?
  accessLevel      MediaAccessLevel      @default(PUBLIC)
  processingStatus MediaProcessingStatus @default(PENDING)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?

  uploader       User                 @relation(fields: [uploadedBy], references: [id])
  folder         MediaFolder?         @relation(fields: [folderId], references: [id])
  links          MediaLink[]
  processingJobs MediaProcessingJob[]
  kycDocuments   KycDocument[]

  @@index([uploadedBy])
  @@index([ownerType, ownerId])
  @@index([folderId])
  @@index([fileType])
  @@index([processingStatus])
  @@map("media")
}

model MediaFolder {
  id        String         @id @default(uuid())
  ownerType MediaOwnerType
  ownerId   String
  name      String
  parentId  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children MediaFolder[] @relation("FolderTree")
  media    Media[]

  @@index([ownerType, ownerId])
  @@index([parentId])
  @@map("media_folders")
}

model MediaLink {
  id         String          @id @default(uuid())
  mediaId    String
  entityType MediaEntityType
  entityId   String
  context    MediaContext?
  isPrimary  Boolean         @default(false)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  deletedAt  DateTime?

  media Media @relation(fields: [mediaId], references: [id])

  @@index([mediaId])
  @@index([entityType, entityId])
  @@index([entityType, entityId, context])
  @@map("media_links")
}

model MediaProcessingJob {
  id           String                   @id @default(uuid())
  mediaId      String
  jobType      MediaProcessingJobType
  status       MediaProcessingJobStatus @default(QUEUED)
  attempts     Int                      @default(0)
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  deletedAt    DateTime?

  media Media @relation(fields: [mediaId], references: [id])

  @@index([mediaId])
  @@index([status])
  @@index([jobType])
  @@map("media_processing_jobs")
}

// ─────────────────────────────────────────────
// MODULE 2 — CATALOG
// ─────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  parentId    String?
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent                   Category?                 @relation("CategoryTree", fields: [parentId], references: [id])
  children                 Category[]                @relation("CategoryTree")
  products                 Product[]
  quantityCalculatorConfig QuantityCalculatorConfig?
  productSuggestions       ProductSuggestion[]

  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]

  @@map("brands")
}

model Product {
  id               String        @id @default(uuid())
  vendorId         String
  categoryId       String
  brandId          String?
  name             String
  slug             String        @unique
  description      String
  shortDescription String
  status           ProductStatus @default(DRAFT)
  isReturnable     Boolean       @default(false)
  returnWindowDays Int?
  tags             String[]
  metaTitle        String
  metaDescription  String
  rejectionNote    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  vendor             VendorProfile             @relation(fields: [vendorId], references: [id])
  category           Category                  @relation(fields: [categoryId], references: [id])
  brand              Brand?                    @relation(fields: [brandId], references: [id])
  variants           ProductVariant[]
  shippingOverride   ProductShippingOverride?
  productSuggestions ProductSuggestion[]       @relation("ProductSuggestions")

  @@map("products")
}

model AttributeDefinition {
  id        String   @id @default(uuid())
  name      String
  unit      String?
  createdAt DateTime @default(now())

  variantAttributes VariantAttribute[]

  @@map("attribute_definitions")
}

model Unit {
  id        String   @id @default(uuid())
  name      String
  symbol    String
  code      String   @unique
  type      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryUnitVariants ProductVariant[] @relation("PrimaryUnit")
  baseUnitVariants    ProductVariant[] @relation("BaseUnit")

  @@map("units")
}

model ProductVariant {
  id            String    @id @default(uuid())
  productId     String
  sku           String    @unique
  name          String?
  price         Decimal   @db.Decimal(10, 2)
  sellingPrice  Decimal   @db.Decimal(10, 2)
  costPrice     Decimal?  @db.Decimal(10, 2)
  primaryUnitId String
  coverageArea  Float?
  baseUnitId    String?
  isDefault     Boolean   @default(false)
  isActive      Boolean   @default(true)
  weightKg      Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  product     Product            @relation(fields: [productId], references: [id])
  primaryUnit Unit               @relation("PrimaryUnit", fields: [primaryUnitId], references: [id])
  baseUnit    Unit?              @relation("BaseUnit", fields: [baseUnitId], references: [id])
  attributes  VariantAttribute[]
  inventory   ProductInventory?
  // cartItems  CartItem[]        // added in Module 5
  // orderItems OrderItem[]       // added in Module 5

  @@map("product_variants")
}

model VariantAttribute {
  id          String @id @default(uuid())
  variantId   String
  attributeId String
  value       String

  variant   ProductVariant      @relation(fields: [variantId], references: [id])
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id])

  @@unique([variantId, attributeId])
  @@map("variant_attributes")
}

model ProductInventory {
  id                String   @id @default(uuid())
  variantId         String   @unique
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(5)
  allowBackorder    Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("product_inventory")
}

model ProductSuggestion {
  id                 String               @id @default(uuid())
  sourceType         SuggestionSourceType
  sourceId           String
  suggestedProductId String
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())

  category         Category @relation(fields: [sourceId], references: [id])
  suggestedProduct Product  @relation("ProductSuggestions", fields: [suggestedProductId], references: [id])

  @@unique([sourceType, sourceId, suggestedProductId])
  @@map("product_suggestions")
}

model QuantityCalculatorConfig {
  id            String   @id @default(uuid())
  categoryId    String   @unique
  materialName  String
  formulaConfig Json
  inputLabels   Json
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])

  @@map("quantity_calculator_configs")
}
