// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  VENDOR
  PROFESSIONAL
  ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
  PHONE
}

enum KycDocumentType {
  AADHAAR
  PAN
  GST
}

enum KycStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
}

enum SuggestionSourceType {
  PRODUCT
  CATEGORY
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id              String       @id @default(uuid())
  name            String
  email           String?      @unique
  phone           String?      @unique
  passwordHash    String?
  role            UserRole     @default(CUSTOMER)
  provider        AuthProvider @default(EMAIL)
  googleId        String?      @unique
  avatarUrl       String?
  isEmailVerified Boolean      @default(false)
  isPhoneVerified Boolean      @default(false)
  isActive        Boolean      @default(true)
  fcmToken        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  addresses        Address[]
  refreshTokens    RefreshToken[]
  otpVerifications OtpVerification[]
  kycDocuments     KycDocument[]
  vendorProfile    VendorProfile?
  professionalProfile ProfessionalProfile?

  @@map("users")
}

model Address {
  id        String    @id @default(uuid())
  userId    String
  label     String?
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  latitude  Float?
  longitude Float?
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@map("addresses")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model OtpVerification {
  id         String    @id @default(uuid())
  userId     String?
  target     String
  otp        String
  purpose    String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("otp_verifications")
}

model KycDocument {
  id            String          @id @default(uuid())
  userId        String
  documentType  KycDocumentType
  documentNo    String
  status        KycStatus       @default(PENDING)
  rejectionNote String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, documentType])
  @@map("kyc_documents")
}

model VendorProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  businessName    String
  businessAddress String?
  city            String?
  state           String?
  pincode         String?
  latitude        Float?
  longitude       Float?
  gstNumber       String?
  isApproved      Boolean   @default(false)
  approvedAt      DateTime?
  bio             String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user     User      @relation(fields: [userId], references: [id])
  products Product[]

  @@map("vendor_profiles")
}

model ProfessionalProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  displayName     String
  slug            String    @unique
  tagline         String?
  bio             String?
  city            String?
  state           String?
  pincode         String?
  latitude        Float?
  longitude       Float?
  experienceYears Int?
  websiteUrl      String?
  instagramUrl    String?
  isApproved      Boolean   @default(false)
  approvedAt      DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user User @relation(fields: [userId], references: [id])

  @@map("professional_profiles")
}

// ─────────────────────────────────────────────
// MODULE 2 — CATALOG
// ─────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  parentId    String?
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent                   Category?                 @relation("CategoryTree", fields: [parentId], references: [id])
  children                 Category[]                @relation("CategoryTree")
  products                 Product[]
  quantityCalculatorConfig QuantityCalculatorConfig?
  productSuggestions       ProductSuggestion[]

  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]

  @@map("brands")
}

model Product {
  id                String        @id @default(uuid())
  vendorId          String
  categoryId        String
  brandId           String?
  name              String
  slug              String        @unique
  description       String
  shortDescription  String
  status            ProductStatus @default(DRAFT)
  isReturnable      Boolean       @default(false)
  returnWindowDays  Int?
  tags              String[]
  metaTitle         String
  metaDescription   String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  vendor             VendorProfile           @relation(fields: [vendorId], references: [id])
  category           Category                @relation(fields: [categoryId], references: [id])
  brand              Brand?                  @relation(fields: [brandId], references: [id])
  variants           ProductVariant[]
  // shippingOverride ProductShippingOverride?
  productSuggestions ProductSuggestion[]     @relation("ProductSuggestions")

  @@map("products")
}

model AttributeDefinition {
  id        String   @id @default(uuid())
  name      String
  unit      String?
  createdAt DateTime @default(now())

  variantAttributes VariantAttribute[]

  @@map("attribute_definitions")
}

model Unit {
  id        String   @id @default(uuid())
  name      String
  symbol    String
  code      String   @unique
  type      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryUnitVariants ProductVariant[] @relation("PrimaryUnit")
  baseUnitVariants    ProductVariant[] @relation("BaseUnit")

  @@map("units")
}

model ProductVariant {
  id            String    @id @default(uuid())
  productId     String
  sku           String    @unique
  name          String?
  price         Decimal   @db.Decimal(10, 2)
  sellingPrice  Decimal   @db.Decimal(10, 2)
  costPrice     Decimal?  @db.Decimal(10, 2)
  primaryUnitId String
  coverageArea  Float?
  baseUnitId    String?
  isDefault     Boolean   @default(false)
  isActive      Boolean   @default(true)
  weightKg      Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  product     Product             @relation(fields: [productId], references: [id])
  primaryUnit Unit                @relation("PrimaryUnit", fields: [primaryUnitId], references: [id])
  baseUnit    Unit?               @relation("BaseUnit", fields: [baseUnitId], references: [id])
  attributes  VariantAttribute[]
  inventory   ProductInventory?
  // cartItems  CartItem[]        // added in Module 5
  // orderItems OrderItem[]       // added in Module 5

  @@map("product_variants")
}

model VariantAttribute {
  id          String @id @default(uuid())
  variantId   String
  attributeId String
  value       String

  variant   ProductVariant      @relation(fields: [variantId], references: [id])
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id])

  @@unique([variantId, attributeId])
  @@map("variant_attributes")
}

model ProductInventory {
  id                String   @id @default(uuid())
  variantId         String   @unique
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(5)
  allowBackorder    Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("product_inventory")
}

model ProductSuggestion {
  id                 String               @id @default(uuid())
  sourceType         SuggestionSourceType
  sourceId           String
  suggestedProductId String
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())

  category         Category @relation(fields: [sourceId], references: [id])
  suggestedProduct Product  @relation("ProductSuggestions", fields: [suggestedProductId], references: [id])

  @@unique([sourceType, sourceId, suggestedProductId])
  @@map("product_suggestions")
}

model QuantityCalculatorConfig {
  id            String   @id @default(uuid())
  categoryId    String   @unique
  materialName  String
  formulaConfig Json
  inputLabels   Json
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])

  @@map("quantity_calculator_configs")
}
