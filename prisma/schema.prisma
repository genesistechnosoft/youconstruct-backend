// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  VENDOR
  PROFESSIONAL
  ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
  PHONE
}

enum KycDocumentType {
  AADHAAR
  PAN
  GST
}

enum KycStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
}

enum SuggestionSourceType {
  PRODUCT
  CATEGORY
}

enum VendorOnboardingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum VendorPlan {
  FREE
  PRO
  ENTERPRISE
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PayoutTriggerType {
  MANUAL
  SCHEDULED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionReason {
  ORDER_EARNING
  PAYOUT
  REFUND_DEDUCTION
  ADJUSTMENT
}

enum PreferredPaymentMethod {
  CASH
  ONLINE
  BOTH
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id              String       @id @default(uuid())
  name            String
  email           String?      @unique
  phone           String?      @unique
  passwordHash    String?
  role            UserRole     @default(CUSTOMER)
  provider        AuthProvider @default(EMAIL)
  googleId        String?      @unique
  avatarUrl       String?
  isEmailVerified Boolean      @default(false)
  isPhoneVerified Boolean      @default(false)
  isActive        Boolean      @default(true)
  fcmToken        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  addresses        Address[]
  refreshTokens    RefreshToken[]
  otpVerifications OtpVerification[]
  kycDocuments     KycDocument[]
  vendorProfile    VendorProfile?
  professionalProfile ProfessionalProfile?

  @@map("users")
}

model Address {
  id        String    @id @default(uuid())
  userId    String
  label     String?
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  latitude  Float?
  longitude Float?
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@map("addresses")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model OtpVerification {
  id         String    @id @default(uuid())
  userId     String?
  target     String
  otp        String
  purpose    String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("otp_verifications")
}

model KycDocument {
  id            String          @id @default(uuid())
  userId        String
  documentType  KycDocumentType
  documentNo    String?
  fileUrl       String?
  status        KycStatus       @default(PENDING)
  rejectionNote String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, documentType])
  @@map("kyc_documents")
}

model VendorProfile {
  id               String                 @id @default(uuid())
  userId           String                 @unique
  businessName     String
  businessAddress  String?
  city             String?
  state            String?
  pincode          String?
  latitude         Float?
  longitude        Float?
  gstNumber        String?
  isApproved       Boolean                @default(false)
  approvedAt       DateTime?
  bio              String?
  onboardingStatus VendorOnboardingStatus @default(DRAFT)
  submittedAt      DateTime?
  reviewedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?

  user          User                 @relation(fields: [userId], references: [id])
  products      Product[]
  storeSettings VendorStoreSettings?
  membership    VendorMembership?
  wallet        VendorWallet?
  transactions  VendorTransaction[]
  bankAccount   VendorBankAccount?
  payouts       VendorPayout[]

  @@map("vendor_profiles")
}

model VendorStoreSettings {
  id                     String                  @id @default(uuid())
  vendorId               String                  @unique
  shippingPolicy         String?
  refundPolicy           String?
  cancellationPolicy     String?
  preferredPaymentMethod PreferredPaymentMethod?
  supportPhone           String?
  supportEmail           String?
  supportAddressLine1    String?
  supportAddressLine2    String?
  supportCity            String?
  supportState           String?
  supportPincode         String?
  seoTitle               String?
  seoDescription         String?
  seoKeywords            String?
  ogTitle                String?
  ogDescription          String?
  twitterTitle           String?
  twitterDescription     String?
  socialInstagram        String?
  socialFacebook         String?
  socialTwitter          String?
  socialYoutube          String?
  socialLinkedin         String?
  socialPinterest        String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  vendor VendorProfile @relation(fields: [vendorId], references: [id])

  @@map("vendor_store_settings")
}

model VendorMembership {
  id             String     @id @default(uuid())
  vendorId       String     @unique
  plan           VendorPlan @default(FREE)
  startedAt      DateTime   @default(now())
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  storageLimitMb Int        @default(0)
  storageUsedMb  Float      @default(0)
  productLimit   Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  vendor VendorProfile @relation(fields: [vendorId], references: [id])

  @@map("vendor_memberships")
}

model VendorWallet {
  id             String   @id @default(uuid())
  vendorId       String   @unique
  balance        Decimal  @default(0) @db.Decimal(12, 2)
  lockedBalance  Decimal  @default(0) @db.Decimal(12, 2)
  totalEarned    Decimal  @default(0) @db.Decimal(12, 2)
  totalWithdrawn Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vendor       VendorProfile       @relation(fields: [vendorId], references: [id])
  transactions VendorTransaction[]
  payouts      VendorPayout[]

  @@map("vendor_wallets")
}

model VendorTransaction {
  id            String            @id @default(uuid())
  vendorId      String
  walletId      String
  type          TransactionType
  reason        TransactionReason
  amount        Decimal           @db.Decimal(12, 2)
  balanceBefore Decimal           @db.Decimal(12, 2)
  balanceAfter  Decimal           @db.Decimal(12, 2)
  referenceId   String?
  referenceType String?
  note          String?
  createdAt     DateTime          @default(now())

  vendor VendorProfile @relation(fields: [vendorId], references: [id])
  wallet VendorWallet  @relation(fields: [walletId], references: [id])

  @@map("vendor_transactions")
}

model VendorBankAccount {
  id                String    @id @default(uuid())
  vendorId          String    @unique
  accountHolderName String
  accountNumber     String
  ifscCode          String
  bankName          String
  branchName        String?
  isVerified        Boolean   @default(false)
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  vendor  VendorProfile  @relation(fields: [vendorId], references: [id])
  payouts VendorPayout[]

  @@map("vendor_bank_accounts")
}

model VendorPayout {
  id               String            @id @default(uuid())
  vendorId         String
  walletId         String
  bankAccountId    String
  amount           Decimal           @db.Decimal(12, 2)
  status           PayoutStatus      @default(PENDING)
  triggerType      PayoutTriggerType
  scheduledFor     DateTime?
  processedAt      DateTime?
  failureReason    String?
  razorpayPayoutId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  vendor      VendorProfile     @relation(fields: [vendorId], references: [id])
  wallet      VendorWallet      @relation(fields: [walletId], references: [id])
  bankAccount VendorBankAccount @relation(fields: [bankAccountId], references: [id])

  @@map("vendor_payouts")
}

model ProfessionalProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  displayName     String
  slug            String    @unique
  tagline         String?
  bio             String?
  city            String?
  state           String?
  pincode         String?
  latitude        Float?
  longitude       Float?
  experienceYears Int?
  websiteUrl      String?
  instagramUrl    String?
  isApproved      Boolean   @default(false)
  approvedAt      DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user User @relation(fields: [userId], references: [id])

  @@map("professional_profiles")
}

// ─────────────────────────────────────────────
// MODULE 2 — CATALOG
// ─────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  parentId    String?
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent                   Category?                 @relation("CategoryTree", fields: [parentId], references: [id])
  children                 Category[]                @relation("CategoryTree")
  products                 Product[]
  quantityCalculatorConfig QuantityCalculatorConfig?
  productSuggestions       ProductSuggestion[]

  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]

  @@map("brands")
}

model Product {
  id                String        @id @default(uuid())
  vendorId          String
  categoryId        String
  brandId           String?
  name              String
  slug              String        @unique
  description       String
  shortDescription  String
  status            ProductStatus @default(DRAFT)
  isReturnable      Boolean       @default(false)
  returnWindowDays  Int?
  tags              String[]
  metaTitle         String
  metaDescription   String
  rejectionNote     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  vendor             VendorProfile           @relation(fields: [vendorId], references: [id])
  category           Category                @relation(fields: [categoryId], references: [id])
  brand              Brand?                  @relation(fields: [brandId], references: [id])
  variants           ProductVariant[]
  // shippingOverride ProductShippingOverride?
  productSuggestions ProductSuggestion[]     @relation("ProductSuggestions")

  @@map("products")
}

model AttributeDefinition {
  id        String   @id @default(uuid())
  name      String
  unit      String?
  createdAt DateTime @default(now())

  variantAttributes VariantAttribute[]

  @@map("attribute_definitions")
}

model Unit {
  id        String   @id @default(uuid())
  name      String
  symbol    String
  code      String   @unique
  type      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryUnitVariants ProductVariant[] @relation("PrimaryUnit")
  baseUnitVariants    ProductVariant[] @relation("BaseUnit")

  @@map("units")
}

model ProductVariant {
  id            String    @id @default(uuid())
  productId     String
  sku           String    @unique
  name          String?
  price         Decimal   @db.Decimal(10, 2)
  sellingPrice  Decimal   @db.Decimal(10, 2)
  costPrice     Decimal?  @db.Decimal(10, 2)
  primaryUnitId String
  coverageArea  Float?
  baseUnitId    String?
  isDefault     Boolean   @default(false)
  isActive      Boolean   @default(true)
  weightKg      Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  product     Product             @relation(fields: [productId], references: [id])
  primaryUnit Unit                @relation("PrimaryUnit", fields: [primaryUnitId], references: [id])
  baseUnit    Unit?               @relation("BaseUnit", fields: [baseUnitId], references: [id])
  attributes  VariantAttribute[]
  inventory   ProductInventory?
  // cartItems  CartItem[]        // added in Module 5
  // orderItems OrderItem[]       // added in Module 5

  @@map("product_variants")
}

model VariantAttribute {
  id          String @id @default(uuid())
  variantId   String
  attributeId String
  value       String

  variant   ProductVariant      @relation(fields: [variantId], references: [id])
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id])

  @@unique([variantId, attributeId])
  @@map("variant_attributes")
}

model ProductInventory {
  id                String   @id @default(uuid())
  variantId         String   @unique
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(5)
  allowBackorder    Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("product_inventory")
}

model ProductSuggestion {
  id                 String               @id @default(uuid())
  sourceType         SuggestionSourceType
  sourceId           String
  suggestedProductId String
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())

  category         Category @relation(fields: [sourceId], references: [id])
  suggestedProduct Product  @relation("ProductSuggestions", fields: [suggestedProductId], references: [id])

  @@unique([sourceType, sourceId, suggestedProductId])
  @@map("product_suggestions")
}

model QuantityCalculatorConfig {
  id            String   @id @default(uuid())
  categoryId    String   @unique
  materialName  String
  formulaConfig Json
  inputLabels   Json
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])

  @@map("quantity_calculator_configs")
}
