NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
SWAGGER_ENABLED=true
CORS_ORIGINS=localhost
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/youconstruct

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=change_this_to_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

STORAGE_DRIVER=local
STORAGE_LOCAL_PUBLIC_PATH=./uploads/public
STORAGE_LOCAL_PRIVATE_PATH=./uploads/private
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/uploads/public

MEDIA_MAX_IMAGE_SIZE_BYTES=10485760
MEDIA_MAX_VIDEO_SIZE_BYTES=209715200
MEDIA_MAX_DOCUMENT_SIZE_BYTES=20971520
MEDIA_QUEUE_ATTEMPTS=3
MEDIA_QUEUE_BACKOFF_MS=2000

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GOOGLE_MAPS_API_KEY=
